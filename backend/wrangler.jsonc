{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ashvini-owner-cms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Review copy only: verify model availability and account quota before deployment/inference.
  "ai": { "binding": "AI" },
  "routes": [{ "pattern": "bettercallashvini.com/*", "zone_id": "9caba8a39454b24e1b7e7761d24232e9" }],
  "vars": {
    "OWNER_EMAIL": "kumarak9335@gmail.com",
    "PAGES_ORIGIN": "https://ashvini-portfolio.pages.dev",
    "SITE_ORIGIN": "https://bettercallashvini.com",
    "PROXY_ENABLED": "true"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ashvini-owner-cms",
    "database_id": "ea848e4c-59ff-492e-996d-acaa13381ea8",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ashvini-portfolio-media" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
